{
    "name": "jwtue/firefly-iii-fints-companion",
    "description": "A companion web UI for the FinTS importer: shared bank logins, scheduling, run history and notifications, without modifying the importer.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "slim/twig-view": "^3.3",
        "guzzlehttp/guzzle": "^7.8",
        "psr/http-client": "^1.0",
        "dragonmantank/cron-expression": "^3.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
