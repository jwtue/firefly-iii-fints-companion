{% extends 'layout.twig' %}
{% block title %}{{ t('dashboard.title') }} — {{ t('nav.brand') }}{% endblock %}
{% block content %}
    <h1>{{ t('dashboard.title') }}</h1>

    {% if not firefly_configured or not importer_configured %}
        <div class="flash warning">
            {% if not importer_configured %}{{ t('dashboard.need_importer') }} {% endif %}
            {% if not firefly_configured %}{{ t('dashboard.need_firefly') }} {% endif %}
            {{ t('dashboard.configure_at') }}
        </div>
    {% endif %}

    {% if not scheduler_enabled %}
        <div class="flash warning">{{ t('dashboard.scheduler_off') }}</div>
    {% endif %}

    {% if importable > 0 %}
        <div class="flash success">
            {{ t('import.banner', { count: importable }) }}
            <a href="/import">{{ t('import.title') }}</a>
        </div>
    {% endif %}

    <div class="card">
        <div class="btn-row">
            <a class="btn primary" href="/accounts/new">{{ t('dashboard.new_account') }}</a>
            <a class="btn" href="/logins/new">{{ t('dashboard.new_login') }}</a>
            <span class="muted">{{ t('dashboard.logins_count', { count: login_count }) }}</span>
        </div>
    </div>

    <h2>{{ t('dashboard.accounts_h') }}</h2>
    <div class="card">
        {% if accounts is empty %}
            <p class="muted">{{ t('dashboard.no_accounts') }}</p>
        {% else %}
        <table>
            <tr><th>{{ t('col.account') }}</th><th>{{ t('col.login') }}</th><th>{{ t('col.schedule') }}</th><th>{{ t('col.last_run') }}</th><th></th></tr>
            {% for a in accounts %}
            <tr>
                <td><strong>{{ a.name }}</strong><br><span class="muted">{{ a.slug }}.json</span></td>
                <td>{{ a.login_name }}</td>
                <td>{% if a.schedule_cron %}<code>{{ a.schedule_cron }}</code>{% else %}<span class="muted">{{ t('common.manual') }}</span>{% endif %}</td>
                <td>
                    {% if a.last_run %}
                        {% include 'partials/status_badge.twig' with { status: a.last_run.status } %}
                        <div class="muted">{{ a.last_run.finished_at }}</div>
                    {% else %}
                        {% include 'partials/status_badge.twig' with { status: '' } %}
                    {% endif %}
                </td>
                <td>
                    <form class="inline" method="post" action="/accounts/{{ a.id }}/run">
                        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                        <button class="btn" type="submit">{{ t('action.run_now') }}</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </table>
        {% endif %}
    </div>

    <h2>{{ t('dashboard.recent_h') }}</h2>
    <div class="card">
        {% if recent_runs is empty %}
            <p class="muted">{{ t('dashboard.no_runs') }}</p>
        {% else %}
        <table>
            <tr><th>{{ t('col.when') }}</th><th>{{ t('col.account') }}</th><th>{{ t('col.status') }}</th><th>{{ t('col.detail') }}</th></tr>
            {% for r in recent_runs %}
            <tr>
                <td>{{ r.started_at }}</td>
                <td>{{ r.account_name }}</td>
                <td>{% include 'partials/status_badge.twig' with { status: r.status } %}</td>
                <td><a href="/runs/{{ r.id }}">{{ r.outcome_reason|default('—')|slice(0, 80) }}</a></td>
            </tr>
            {% endfor %}
        </table>
        {% endif %}
    </div>
{% endblock %}
