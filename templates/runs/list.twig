{% extends 'layout.twig' %}
{% block title %}{{ t('runs.title') }} — {{ t('nav.brand') }}{% endblock %}
{% block content %}
    <h1>{{ t('runs.title') }}</h1>
    <div class="card">
        {% if runs is empty %}
            <p class="muted">{{ t('runs.none') }}</p>
        {% else %}
        <table>
            <tr><th>{{ t('runs.col_started') }}</th><th>{{ t('col.account') }}</th><th>{{ t('runs.col_trigger') }}</th><th>{{ t('col.status') }}</th><th>{{ t('runs.col_txns') }}</th><th>{{ t('col.detail') }}</th></tr>
            {% for r in runs %}
            <tr>
                <td>{{ localtime(r.started_at) }}</td>
                <td>{{ r.account_name }}</td>
                <td><span class="muted">{{ r.trigger }}</span></td>
                <td>{% include 'partials/status_badge.twig' with { status: r.status } %}</td>
                <td>{{ r.num_transactions is not null ? r.num_transactions : '—' }}</td>
                <td><a href="/runs/{{ r.id }}">{{ r.outcome_reason|default('view')|slice(0, 70) }}</a></td>
            </tr>
            {% endfor %}
        </table>
        {% endif %}
    </div>
{% endblock %}
