{% set s = status|default('') %}
{% if s == 'success' %}<span class="badge ok">{{ t('status.success') }}</span>
{% elseif s == 'tan_required' %}<span class="badge warn">{{ t('status.tan_required') }}</span>
{% elseif s == 'failure' %}<span class="badge err">{{ t('status.failure') }}</span>
{% elseif s == 'running' %}<span class="badge muted">{{ t('status.running') }}</span>
{% else %}<span class="badge muted">{{ t('status.never') }}</span>
{% endif %}
