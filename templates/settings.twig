{% extends 'layout.twig' %}
{% block title %}{{ t('settings.title') }} — {{ t('nav.brand') }}{% endblock %}
{% block content %}
    <h1>{{ t('settings.title') }}</h1>
    <form method="post" action="/settings">
        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">

        <div class="card">
            <h2>{{ t('settings.importer_h') }}</h2>
            <label for="importer_url">{{ t('settings.importer_url') }}</label>
            <input type="text" id="importer_url" name="importer_url" value="{{ values.importer_url }}"
                   placeholder="http://firefly-fints-importer:8080" {{ from_env.importer_url ? 'readonly' }}>
            <div class="hint">{{ t('settings.importer_url_hint') }}{% if from_env.importer_url %} {{ t('settings.env_fixed') }}{% endif %}</div>

            <label for="importer_public_url">{{ t('settings.importer_public_url') }}</label>
            <input type="text" id="importer_public_url" name="importer_public_url" value="{{ values.importer_public_url }}"
                   placeholder="https://importer.example.org" {{ from_env.importer_public_url ? 'readonly' }}>
            <div class="hint">{{ t('settings.importer_public_url_hint') }}{% if from_env.importer_public_url %} {{ t('settings.env_fixed') }}{% endif %}</div>
        </div>

        <div class="card">
            <h2>{{ t('settings.firefly_h') }}</h2>
            <label for="firefly_url">{{ t('settings.firefly_url') }}</label>
            <input type="text" id="firefly_url" name="firefly_url" value="{{ values.firefly_url }}"
                   placeholder="http://firefly:8080" {{ from_env.firefly_url ? 'readonly' }}>
            <label for="firefly_token">{{ t('settings.firefly_token') }}</label>
            <input type="password" id="firefly_token" name="firefly_token" autocomplete="new-password"
                   placeholder="{{ values.firefly_token_set ? t('settings.token_stored') : t('settings.token_notset') }}"
                   {{ from_env.firefly_token ? 'readonly' }}>
            <div class="hint">{{ t('settings.firefly_token_hint') }}{% if from_env.firefly_token %} {{ t('settings.env_fixed') }}{% endif %}</div>
        </div>

        <div class="card">
            <h2>{{ t('settings.telegram_h') }}</h2>
            <label for="telegram_bot_token">{{ t('settings.bot_token') }}</label>
            <input type="password" id="telegram_bot_token" name="telegram_bot_token" autocomplete="new-password"
                   placeholder="{{ values.telegram_bot_token_set ? t('settings.token_stored') : t('settings.token_notset') }}"
                   {{ from_env.telegram_bot_token ? 'readonly' }}>
            <label for="telegram_chat_id">{{ t('settings.chat_id') }}</label>
            <input type="text" id="telegram_chat_id" name="telegram_chat_id" value="{{ values.telegram_chat_id }}"
                   {{ from_env.telegram_chat_id ? 'readonly' }}>
            <div class="hint">{{ t('settings.telegram_hint') }}</div>

            <div style="margin-top:.6rem;">
                <div class="hint">{{ t('settings.notify_on') }}</div>
                {% for key in ['notify_on_failure', 'notify_on_tan', 'notify_on_success', 'notify_on_missing'] %}
                    <label class="hint" style="display:block;">
                        <input type="checkbox" name="{{ key }}" {{ values[key] ? 'checked' }} {{ from_env[key] ? 'disabled' }}>
                        {{ t('settings.' ~ key) }}
                    </label>
                {% endfor %}
            </div>

            <details class="guide">
                <summary>{{ t('settings.telegram_guide') }}</summary>
                <ol>
                    <li>{{ t('settings.telegram_guide_1') }}</li>
                    <li>{{ t('settings.telegram_guide_2') }}</li>
                    <li>{{ t('settings.telegram_guide_3') }}</li>
                    <li>{{ t('settings.telegram_guide_4') }}</li>
                </ol>
            </details>

            <div class="btn-row" style="margin-top:.8rem;">
                <button class="btn" type="submit" formaction="/settings/test" formmethod="post">{{ t('settings.telegram_test') }}</button>
            </div>
        </div>

        <div class="btn-row"><button class="btn primary" type="submit">{{ t('action.save') }}</button></div>
    </form>
{% endblock %}
