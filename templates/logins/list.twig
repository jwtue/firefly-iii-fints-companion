{% extends 'layout.twig' %}
{% block title %}{{ t('logins.title') }} — {{ t('nav.brand') }}{% endblock %}
{% block content %}
    <h1>{{ t('logins.title') }}</h1>
    <p class="muted">{{ t('logins.intro') }}</p>

    <div class="card">
        <div class="btn-row"><a class="btn primary" href="/logins/new">{{ t('dashboard.new_login') }}</a></div>
    </div>

    <div class="card">
        {% if logins is empty %}
            <p class="muted">{{ t('logins.none') }}</p>
        {% else %}
        <table>
            <tr><th>{{ t('loginform.name') }}</th><th>{{ t('logins.col_bank') }}</th><th>{{ t('logins.col_accounts') }}</th><th>{{ t('logins.col_reauth') }}</th><th></th></tr>
            {% for l in logins %}
            <tr>
                <td><strong>{{ l.name }}</strong></td>
                <td>{{ l.bank_code }}<br><span class="muted">{{ l.bank_username }}</span></td>
                <td>{{ l.account_count }}</td>
                <td>
                    {% if l.persistence_updated_at %}<span class="muted">{{ l.persistence_updated_at }}</span>
                    {% else %}<span class="badge warn">{{ t('common.never') }}</span>{% endif %}
                </td>
                <td>
                    <div class="btn-row">
                        <a class="btn" href="/logins/{{ l.id }}/reauth">{{ t('logins.reauth') }}</a>
                        <a class="btn" href="/logins/{{ l.id }}/edit">{{ t('action.edit') }}</a>
                        <form class="inline" method="post" action="/logins/{{ l.id }}/delete"
                              onsubmit="return confirm('{{ t('action.delete') }}?');">
                            <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                            <button class="btn danger" type="submit">{{ t('action.delete') }}</button>
                        </form>
                    </div>
                </td>
            </tr>
            {% endfor %}
        </table>
        {% endif %}
    </div>
{% endblock %}
