{% extends 'layout.twig' %}
{% block title %}{{ t('logins.reauth') }} — {{ t('nav.brand') }}{% endblock %}
{% block content %}
    <h1>{{ t('reauth.title', { name: login.name }) }}</h1>

    <div class="card">
        <p>{{ t('reauth.intro') }}</p>
        <ol>
            <li>{{ t('reauth.step1') }}</li>
            <li>{{ t('reauth.step2') }}</li>
            <li>{{ t('reauth.step3', { count: account_count }) }}</li>
        </ol>

        <form method="post" action="/logins/{{ login.id }}/reauth">
            <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
            <label for="fints_persistence">{{ t('reauth.field') }}</label>
            <textarea id="fints_persistence" name="fints_persistence" rows="4"
                      placeholder="{{ t('reauth.placeholder') }}" required></textarea>
            <div class="btn-row" style="margin-top:1rem;">
                <button class="btn primary" type="submit">{{ t('reauth.save') }}</button>
                <a class="btn" href="/logins">{{ t('action.cancel') }}</a>
            </div>
        </form>
    </div>
{% endblock %}
