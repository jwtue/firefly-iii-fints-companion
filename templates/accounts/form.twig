{% extends 'layout.twig' %}
{% block title %}{{ is_new ? t('accountform.title_new') : t('accountform.title_edit') }} — {{ t('nav.brand') }}{% endblock %}
{% block content %}
    <h1>{{ is_new ? t('accountform.title_new') : t('accountform.title_edit') }}</h1>

    {% if logins is empty %}
        <div class="flash warning">{{ t('accountform.need_login_first') }} <a href="/logins/new">{{ t('dashboard.new_login') }}</a></div>
    {% endif %}

    <form method="post" action="{{ is_new ? '/accounts' : '/accounts/' ~ account.id }}">
        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">

        <div class="card">
            <div class="grid2">
                <div>
                    <label for="name">{{ t('loginform.name') }}</label>
                    <input type="text" id="name" name="name" value="{{ account.name|default('') }}" required>
                    {% if errors.name %}<div class="field-error">{{ t(errors.name) }}</div>{% endif %}
                </div>
                <div>
                    <label for="slug">{{ t('accountform.identifier') }}</label>
                    <input type="text" id="slug" name="slug" value="{{ account.slug|default('') }}"
                           placeholder="{{ t('accountform.identifier_placeholder') }}">
                    {% if errors.slug %}<div class="field-error">{{ t(errors.slug) }}</div>{% endif %}
                    <div class="hint">{{ t('accountform.identifier_hint') }}</div>
                </div>
            </div>

            <label for="login_id">{{ t('col.login') }}</label>
            <select id="login_id" name="login_id" required>
                <option value="">{{ t('accountform.choose_login') }}</option>
                {% for l in logins %}
                    <option value="{{ l.id }}" {{ account.login_id|default(0) == l.id ? 'selected' }}>{{ l.name }}</option>
                {% endfor %}
            </select>
            {% if errors.login_id %}<div class="field-error">{{ t(errors.login_id) }}</div>{% endif %}
        </div>

        <div class="card">
            <label>{{ t('accountform.selection') }}</label>
            <div class="btn-row">
                <label class="hint"><input type="radio" name="selector_type" value="iban"
                    {{ account.selector_type|default('iban') != 'number' ? 'checked' }} onclick="selType()"> {{ t('accountform.by_iban') }}</label>
                <label class="hint"><input type="radio" name="selector_type" value="number"
                    {{ account.selector_type|default('iban') == 'number' ? 'checked' }} onclick="selType()"> {{ t('accountform.by_card') }}</label>
            </div>
            <div id="sel_iban">
                <label for="bank_account_iban">{{ t('accountform.iban') }}</label>
                <input type="text" id="bank_account_iban" name="bank_account_iban" value="{{ account.bank_account_iban|default('') }}">
                {% if errors.bank_account_iban %}<div class="field-error">{{ t(errors.bank_account_iban) }}</div>{% endif %}
            </div>
            <div id="sel_number">
                <label for="bank_account_number">{{ t('accountform.card_number') }}</label>
                <input type="text" id="bank_account_number" name="bank_account_number" value="{{ account.bank_account_number|default('') }}">
                {% if errors.bank_account_number %}<div class="field-error">{{ t(errors.bank_account_number) }}</div>{% endif %}
                <div class="hint">{{ t('accountform.card_hint') }}</div>
            </div>

            <label for="firefly_account_id">{{ t('accountform.firefly_id') }}</label>
            <input type="text" id="firefly_account_id" name="firefly_account_id" value="{{ account.firefly_account_id|default('') }}" required>
            {% if errors.firefly_account_id %}<div class="field-error">{{ t(errors.firefly_account_id) }}</div>{% endif %}
            <div class="hint">{{ t('accountform.firefly_id_hint') }}</div>
        </div>

        <div class="card">
            <div class="grid2">
                <div>
                    <label for="date_from">{{ t('accountform.window_start') }}</label>
                    <input type="text" id="date_from" name="date_from" value="{{ account.date_from|default('now - 7 days') }}">
                </div>
                <div>
                    <label for="date_to">{{ t('accountform.window_end') }}</label>
                    <input type="text" id="date_to" name="date_to" value="{{ account.date_to|default('now') }}">
                    {% if errors.date_to %}<div class="field-error">{{ t(errors.date_to) }}</div>{% endif %}
                </div>
            </div>
            <div class="hint">{{ t('accountform.window_hint') }}</div>

            <label for="schedule_freq">{{ t('accountform.schedule') }}</label>
            <select id="schedule_freq" name="schedule_freq" onchange="schedFreq()">
                <option value="off"    {{ schedule.freq == 'off' ? 'selected' }}>{{ t('accountform.freq_off') }}</option>
                <option value="hourly" {{ schedule.freq == 'hourly' ? 'selected' }}>{{ t('accountform.freq_hourly') }}</option>
                <option value="daily"  {{ schedule.freq == 'daily' ? 'selected' }}>{{ t('accountform.freq_daily') }}</option>
                <option value="weekly" {{ schedule.freq == 'weekly' ? 'selected' }}>{{ t('accountform.freq_weekly') }}</option>
                <option value="custom" {{ schedule.freq == 'custom' ? 'selected' }}>{{ t('accountform.freq_custom') }}</option>
            </select>
            <div class="grid2">
                <div id="sched_time">
                    <label for="schedule_time">{{ t('accountform.schedule_time') }}</label>
                    <input type="time" id="schedule_time" name="schedule_time" value="{{ schedule.time }}">
                </div>
                <div id="sched_weekday">
                    <label for="schedule_weekday">{{ t('accountform.schedule_weekday') }}</label>
                    <select id="schedule_weekday" name="schedule_weekday">
                        {% for val, key in {'1':'wd_mon','2':'wd_tue','3':'wd_wed','4':'wd_thu','5':'wd_fri','6':'wd_sat','0':'wd_sun'} %}
                            <option value="{{ val }}" {{ schedule.weekday == val ? 'selected' }}>{{ t('accountform.' ~ key) }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div id="sched_custom">
                <label for="schedule_cron_custom">{{ t('accountform.schedule_cron_custom') }}</label>
                <input type="text" id="schedule_cron_custom" name="schedule_cron_custom" value="{{ schedule.custom }}" placeholder="0 1 * * *">
                {% if errors.schedule_cron %}<div class="field-error">{{ t(errors.schedule_cron) }}</div>{% endif %}
            </div>
        </div>

        <div class="card">
            <label for="description_regex_match">{{ t('accountform.regex_match') }}</label>
            <input type="text" id="description_regex_match" name="description_regex_match" value="{{ account.description_regex_match|default('') }}">
            <label for="description_regex_replace">{{ t('accountform.regex_replace') }}</label>
            <input type="text" id="description_regex_replace" name="description_regex_replace" value="{{ account.description_regex_replace|default('') }}">
            <div class="hint">{{ t('accountform.regex_hint') }}</div>

            <div style="margin-top:.8rem;">
                <label class="hint"><input type="checkbox" name="skip_transaction_review" {{ account.skip_transaction_review|default(1) ? 'checked' }}> {{ t('accountform.skip_review') }}</label>
                <label class="hint"><input type="checkbox" name="force_mt940" {{ account.force_mt940|default(0) ? 'checked' }}> {{ t('accountform.force_mt940') }}</label>
                <label class="hint"><input type="checkbox" name="enabled" {{ account.enabled|default(1) ? 'checked' }}> {{ t('accountform.enabled') }}</label>
            </div>
        </div>

        <div class="btn-row">
            <button class="btn primary" type="submit">{{ t('action.save') }}</button>
            <a class="btn" href="/accounts">{{ t('action.cancel') }}</a>
        </div>
    </form>

    <script>
        function selType() {
            var number = document.querySelector('input[name=selector_type][value=number]').checked;
            document.getElementById('sel_iban').style.display = number ? 'none' : 'block';
            document.getElementById('sel_number').style.display = number ? 'block' : 'none';
        }
        selType();

        function schedFreq() {
            var f = document.getElementById('schedule_freq').value;
            document.getElementById('sched_time').style.display = (f === 'daily' || f === 'weekly') ? 'block' : 'none';
            document.getElementById('sched_weekday').style.display = (f === 'weekly') ? 'block' : 'none';
            document.getElementById('sched_custom').style.display = (f === 'custom') ? 'block' : 'none';
        }
        schedFreq();
    </script>
{% endblock %}
