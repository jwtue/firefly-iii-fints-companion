{% extends 'layout.twig' %}
{% block title %}{{ t('accounts.title') }} — {{ t('nav.brand') }}{% endblock %}
{% block content %}
    <h1>{{ t('accounts.title') }}</h1>
    <div class="card">
        <div class="btn-row">
            <a class="btn primary" href="/accounts/new">{{ t('dashboard.new_account') }}</a>
            {% if importer_pub() %}<a class="btn" href="{{ importer_pub() }}/" target="_blank" rel="noopener">{{ t('accounts.open_importer') }}</a>{% endif %}
        </div>
        {% if importer_pub() %}<div class="hint" style="margin-top:.5rem;">{{ t('accounts.wizard_hint') }}</div>{% endif %}
    </div>

    <div class="card">
        {% if accounts is empty %}
            <p class="muted">{{ t('accounts.none') }}</p>
        {% else %}
        <table>
            <tr><th>{{ t('col.account') }}</th><th>{{ t('col.login') }}</th><th>{{ t('col.target') }}</th><th>{{ t('col.schedule') }}</th><th></th></tr>
            {% for a in accounts %}
            <tr>
                <td>
                    <strong>{{ a.name }}</strong>
                    {% if not a.enabled %}<span class="badge muted">{{ t('common.disabled') }}</span>{% endif %}
                    <br><span class="muted">{{ a.slug }}.json</span>
                </td>
                <td>{{ a.login_name }}</td>
                <td>
                    {% if a.selector_type == 'number' %}{{ t('accounts.card_prefix') }} {{ a.bank_account_number }}
                    {% else %}{{ a.bank_account_iban }}{% endif %}
                    <br><span class="muted">{{ t('accounts.to_firefly', { id: a.firefly_account_id }) }}</span>
                </td>
                <td>{% if a.schedule_cron %}{{ schedule_label(a.schedule_cron) }}{% else %}<span class="muted">{{ t('common.manual') }}</span>{% endif %}</td>
                <td>
                    <div class="btn-row">
                        {% if importer_pub() %}<a class="btn" href="{{ importer_pub() }}/?config={{ a.slug }}.json" target="_blank" rel="noopener" title="{{ t('accounts.wizard_title') }}">{{ t('accounts.wizard') }}</a>{% endif %}
                        <form class="inline" method="post" action="/accounts/{{ a.id }}/run">
                            <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                            <button class="btn" type="submit">{{ t('action.run') }}</button>
                        </form>
                        <a class="btn" href="/accounts/{{ a.id }}/edit">{{ t('action.edit') }}</a>
                        <form class="inline" method="post" action="/accounts/{{ a.id }}/duplicate">
                            <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                            <button class="btn" type="submit">{{ t('action.duplicate') }}</button>
                        </form>
                        <form class="inline" method="post" action="/accounts/{{ a.id }}/delete"
                              onsubmit="return confirm('{{ t('action.delete') }}?');">
                            <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                            <button class="btn danger" type="submit">{{ t('action.delete') }}</button>
                        </form>
                    </div>
                </td>
            </tr>
            {% endfor %}
        </table>
        {% endif %}
    </div>
{% endblock %}
