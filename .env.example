# FinTS Companion configuration (environment prefix SIDECAR_).
# Copy to .env for local runs, or provide these through your orchestrator.

# --- Authentication (required: the UI edits bank secrets) --------------------
# Either a plaintext password (hashed in memory at startup) ...
SIDECAR_PASSWORD=change-me
# ... or a precomputed bcrypt hash, which takes precedence. Generate one with:
#   php -r "echo password_hash('yourPassword', PASSWORD_DEFAULT), PHP_EOL;"
SIDECAR_PASSWORD_HASH=
# The container refuses to start unless one of the two above is set.

# --- Importer ----------------------------------------------------------------
SIDECAR_IMPORTER_URL=http://firefly-fints-importer:8080

# --- Firefly III (one instance; per-account IDs are set per account) ---------
SIDECAR_FIREFLY_URL=http://firefly:8080
SIDECAR_FIREFLY_TOKEN=

# --- Telegram notifications (optional; leave the token blank to disable) -----
SIDECAR_TELEGRAM_BOT_TOKEN=
SIDECAR_TELEGRAM_CHAT_ID=

# --- Paths (defaults shown; both live under the /data volume) ----------------
SIDECAR_CONFIG_DIR=/data/configurations
SIDECAR_DATABASE_PATH=/data/sidecar/sidecar.sqlite
SIDECAR_LOCK_FILE=/data/sidecar/run.lock

# --- Misc --------------------------------------------------------------------
# Secure flag on the session cookie; keep true when TLS terminates upstream.
SIDECAR_BEHIND_TLS=true
# Scheduler tick, in seconds.
SIDECAR_SCHEDULER_INTERVAL=60
# Verbose error pages — development only.
SIDECAR_DEBUG=false
