# Firefly FinTS Sidecar — configuration (env prefix: SIDECAR_)
# Copy to .env for local runs, or provide these via your orchestrator.

# --- Paths -------------------------------------------------------------------
# Shared config volume. MUST be the same directory the importer reads from, and
# on the importer side it MUST be mounted at /data/configurations (NOT
# /app/configurations — the automate path resolves data/configurations/<name>
# relative to CWD=/, so the wrong mount fails silently).
SIDECAR_CONFIG_DIR=/data/configurations
# Sidecar-owned state (SQLite run history). Separate from the config volume.
SIDECAR_STATE_DIR=/data/state

# --- Importer ----------------------------------------------------------------
SIDECAR_IMPORTER_BASE_URL=http://firefly-fints-importer:8080
SIDECAR_IMPORTER_TIMEOUT_SECONDS=600
# Set true only after the upstream machine-readable-status PR is deployed.
SIDECAR_IMPORTER_SUPPORTS_JSON=false

# --- Auth (fail-closed: set at least one of the two paths below) --------------
# Path A — password login. Generate a hash with:
#   python -c "from app.auth import hash_password; print(hash_password('yourpw'))"
SIDECAR_PASSWORD_HASH=
# Signing key for session + CSRF tokens (>=16 chars). Required if PASSWORD_HASH is set.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SIDECAR_SECRET_KEY=

# Path B — bypass auth for trusted networks (comma-separated CIDRs). Evaluated
# against the DIRECT socket peer only, never X-Forwarded-For. If a reverse proxy
# sits in front, its container IP is the peer — trust that network deliberately
# or leave this empty and rely on the password login.
SIDECAR_TRUSTED_NETWORKS=

# The container REFUSES TO START unless PASSWORD_HASH or TRUSTED_NETWORKS is set.

# --- Notifications -----------------------------------------------------------
# Apprise-style URLs, comma-separated. Supported schemes: ntfy(s), tgram(s).
# Alerts fire on failed runs, on "TAN required", and via an hourly dead-man's
# switch when a scheduled config stops succeeding. Empty => alerts only logged.
#   ntfy://ntfy.example/firefly-import
#   tgram://<bottoken>/<chatid>
SIDECAR_NOTIFY_URLS=

# --- Server ------------------------------------------------------------------
# Secure flag on the session cookie — keep true when TLS terminates upstream.
SIDECAR_BEHIND_TLS=true
SIDECAR_SESSION_MAX_AGE_SECONDS=28800
