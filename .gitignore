# PHP / Composer
/vendor/
composer.phar
.phpunit.cache/
.phpunit.result.cache

# Runtime state (never commit — may hold run history / redacted response bodies)
/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Secrets — configs hold the bank PIN / tokens in cleartext, never commit
.env
*.env
!*.env.example

# Editor
.idea/
.vscode/
*.swp

# Leftovers from the previous Python implementation (should not reappear)
__pycache__/
*.egg-info/
/build/
.pytest_cache/
.venv/
